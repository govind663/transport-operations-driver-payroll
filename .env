# ============================================================
# WHATSAPP API CONFIGURATION
# ============================================================
# Supported Modes:
# local = Personal WhatsApp (wa.me chat link)
# live  = WhatsApp Cloud API (Automatic message dispatch)
WHATSAPP_MODE=local

# ============================================================
# WHATSAPP CLOUD API
# ============================================================
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v27.0

# Meta WhatsApp Business API Credentials
# Required only when WHATSAPP_MODE=live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ============================================================
# WHATSAPP API TIMEOUT
# ============================================================
WHATSAPP_API_TIMEOUT=30
WHATSAPP_API_CONNECT_TIMEOUT=10

# ============================================================
# WHATSAPP MEDIA CONFIGURATION
# ============================================================
# Maximum document upload size in MB
WHATSAPP_MAX_MEDIA_SIZE_MB=100

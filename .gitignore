# =====================================================
# SYSTEM / OS FILES
# =====================================================

.DS_Store
Thumbs.db
*.swp
*.swo


# =====================================================
# ENVIRONMENT FILES / SECRETS
# =====================================================

.env
.env.*
!.env.example
!.env.example.*

# Additional environment / secret files
.env.backup
.env.production
.env.local
.env.testing

/auth.json


# =====================================================
# LOG FILES
# =====================================================

*.log
npm-debug.log
yarn-error.log
pnpm-debug.log


# =====================================================
# PHP / LARAVEL CACHE
# =====================================================

.phpactor.json
.phpunit.result.cache
/.phpunit.cache


# =====================================================
# IDE / EDITOR SETTINGS
# =====================================================

/.fleet
/.idea
/.nova
/.vscode
/.zed


# =====================================================
# NODE / FRONTEND
# =====================================================

/node_modules
/public/build
/public/hot


# =====================================================
# LARAVEL STORAGE
# =====================================================

# Ignore generated storage contents
/storage/*


# =====================================================
# ALLOW REQUIRED STORAGE DIRECTORIES
# =====================================================

# Storage root
!/storage/app/
!/storage/framework/
!/storage/logs/

# -----------------------------------------------------
# storage/app
# -----------------------------------------------------

!/storage/app/public/
!/storage/app/public/**

# Public uploaded image directories
!/storage/app/public/about-section-images/
!/storage/app/public/about-section-images/**

# -----------------------------------------------------
# storage/framework
# -----------------------------------------------------

!/storage/framework/cache/
!/storage/framework/cache/data/

!/storage/framework/sessions/

!/storage/framework/testing/

!/storage/framework/views/

# -----------------------------------------------------
# storage/logs
# -----------------------------------------------------

# Keep directory but ignore generated log files
/storage/logs/*
!/storage/logs/.gitkeep


# =====================================================
# KEEP EMPTY REQUIRED DIRECTORIES IN GIT
# =====================================================

/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep

/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep

/storage/framework/testing/*
!/storage/framework/testing/.gitkeep

/storage/framework/views/*
!/storage/framework/views/.gitkeep


# =====================================================
# LARAVEL GENERATED KEY FILES
# =====================================================

/storage/*.key


# =====================================================
# LARAVEL PAIL
# =====================================================

/storage/pail


# =====================================================
# STORAGE PUBLIC SYMLINK / DIRECTORY
# =====================================================

!/storage/public/
!/storage/public/**


# =====================================================
# VENDOR
# =====================================================

# Keep vendor OUT of Git when Composer install is
# performed during deployment.
/vendor


# =====================================================
# LARAVEL HOMESTEAD
# =====================================================

Homestead.json
Homestead.yaml


# =====================================================
# TEST / DEBUG
# =====================================================

.phpunit.result.cache